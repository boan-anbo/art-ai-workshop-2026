---
import Workshops from '../content/workshops.md';
import Preparation from '../content/preparation.md';
import PreparationExercises from '../components/PreparationExercises.astro';
import { questions } from '../data/questions';
import QuestionAnswers from '../components/QuestionAnswers.astro';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { encryptQa } from '../lib/encrypt-qa';
import '../styles/site.css';

const sections = [
  { id: 'workshops', number: '01', label: '工作坊模組' },
  { id: 'preparation', number: '02', label: '課前準備' },
  { id: 'questions', number: '03', label: '對同學課前問題的回覆' },
];
const workspace = 'https://github.com/boan-anbo/art-ai-workshop-2026';
const issues = `${workspace}/issues/new?template=question.yml`;
const container = await AstroContainer.create();
const encryptedQa = encryptQa(await container.renderToString(QuestionAnswers));

---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="AI 與藝術史工作坊：課前準備、工作坊模組與匿名化的假設情境問答。" />
    <meta name="theme-color" content="#ffffff" />
    <title>AI 與藝術史工作坊</title>
    <link rel="canonical" href={new URL(import.meta.env.BASE_URL, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#preparation">跳至課前準備</a>
    <header class="book-topbar">
      <div class="topbar-brand">
        <a class="wordmark" href={import.meta.env.BASE_URL}>AI 與藝術史工作坊</a>
        <button type="button" class="rail-toggle" aria-label="收起目錄" aria-expanded="true" aria-controls="book-spine" hidden><span aria-hidden="true">‹</span></button>
      </div>
      <span class="running-head" aria-hidden="true"></span>
      <a class="workspace-link" href={workspace}>Workspace ↗</a>
      <details class="mobile-toc">
        <summary>目錄 <span aria-hidden="true">☰</span></summary>
        <nav aria-label="行動版目錄">
          {sections.map((section) => <a href={`#${section.id}`} data-section-link={section.id}><span>{section.number}</span>{section.label}</a>)}
        </nav>
      </details>
      <div class="reading-progress" aria-hidden="true"></div>
    </header>
    <div class="book-shell">
      <aside class="book-spine" id="book-spine" aria-label="工作坊目錄">
        <nav aria-label="主要導覽">
          <p class="spine-kicker">CUHK · NOV 2026</p>
          <ol>
            {sections.map((section) => <li><a href={`#${section.id}`} data-section-link={section.id} title={`${section.number} ${section.label}`} aria-label={`${section.number} ${section.label}`}><span class="spine-number">{section.number}</span><span class="spine-label">{section.label}</span></a></li>)}
          </ol>

        </nav>
      </aside>
      <div class="book-content">
        <main class="dh-book-reading" id="main-content">
          <section class="intro" aria-labelledby="page-title">
            <div class="intro-main">
              <p class="eyebrow" lang="en">CUHK · ART RESEARCH · NOVEMBER 2026</p>
              <h1 id="page-title">AI 與藝術史工作坊</h1>
              <div class="intro-links">
                <a class="text-link" href="#workshops">工作坊模組 <span aria-hidden="true">↓</span></a>
                <a href="#preparation">課前準備 <span aria-hidden="true">↓</span></a>
                <a href="#questions">對同學課前問題的回覆 <span aria-hidden="true">↓</span></a>
              </div>
              <p class="intro-note">同學們好，我是工作坊的講者安博。本頁整理了課前與課上所需的準備事項、說明與連結；遇到進階步驟，先完成第一步 OpenCode 設定後即可請 Agent 協助理解與操作，鼓勵大家課前先動手試試。目前的工作坊模組是完全按照大家提出的研究需要與研究場景來設計的，並補充了一些大家未特別提及但實際上非常需要的環節（例如如何做對內的研究工作台核查與對外的成果呈現）。下方也回答了大家先前的提問並附上《<a href="https://dhguide.org/">嶺南數字與 AI 人文指南</a>》連結。目前模組為暫定安排，如有任何建議或問題，歡迎到 <a href={issues}>GitHub Issues</a> 留言或發郵件至 <a href="mailto:boan@ln.edu.hk">boan@ln.edu.hk</a>。期待與大家見面！</p>
            </div>
            <aside class="session-note" aria-label="工作坊資料">
              <p class="eyebrow">兩場 · 每場 120 分鐘</p>
              <p class="institution" lang="en">CUHK<br />Department of Fine Arts</p>
              <dl>
                <div><dt>第一場</dt><dd><time datetime="2026-11-06">11 月 6 日</time>，星期五</dd></div>
                <div><dt>第二場</dt><dd><time datetime="2026-11-13">11 月 13 日</time>，星期五</dd></div>
                <div><dt>時間</dt><dd>14:30–16:30<br /><span class="time-zone">香港時間</span></dd></div>
                <div><dt>地點</dt><dd>新亞書院誠明館 2 樓<br /><span class="time-zone" lang="en">Cheng Ming Building 2/F</span></dd></div>
              </dl>
              <p class="session-footnote"><a href="#workshops">看兩場安排 ↓</a></p>
            </aside>
          </section>
          <section class="book-section" data-book-section="工作坊模組" id="workshops" aria-labelledby="workshops-title">
            <div class="section-heading">
              <p class="eyebrow">01 / 兩場 · 每場 120 分鐘</p>
              <h2 id="workshops-title">工作坊模組</h2>
            </div>
            <div class="prose workshop-prose reading-column"><Workshops /></div>
          </section>
          <section class="book-section preparation-section" id="preparation" aria-labelledby="preparation-title" data-book-section="課前準備">
            <div class="section-heading"><p class="eyebrow">02 / BEFORE THE FIRST WORKSHOP</p><h2 id="preparation-title">課前準備</h2></div>
            <div class="composed-row preparation-layout">
              <div class="prose preparation-prose"><Preparation /></div>
              <aside class="margin-note preparation-note" aria-label="準備時的小提醒">
                <p class="eyebrow">卡住 30 分鐘原則</p>
                <p>同一步若卡住超過 30 分鐘，立即停下，把具體錯誤記進 <code>my-work/questions.md</code> 帶到課堂。</p>
                <p class="eyebrow">兩筆費用區分</p>
                <p>OpenCode Go 是 Agent 訂閱；OpenRouter 是課堂程式呼叫 API 的小額儲值，兩者分開。</p>
                <p class="eyebrow">四類目錄原則</p>
                <p><code>sources/raw/</code> 保留原件，永不就地改動；<code>sources/processed/</code> 放處理結果；<code>research/</code> 放筆記；<code>artifacts/</code> 放大型輸出且不進 Git。</p>
              </aside>
            </div>
            <PreparationExercises />
          </section>

        <section class="book-section questions-section" data-book-section="對同學課前問題的回覆" id="questions" aria-labelledby="questions-title">
          <div class="section-heading question-index">
            <p class="eyebrow">03 / {questions.length} 個假設情境問題</p>
            <h2 id="questions-title">對同學課前問題的回覆</h2>
            <p>以下問題已改寫為匿名化的假設情境，用來說明可共用的研究方法。</p>
          </div>
          <div class="doc-frame qa-gate" id="qa-gate">
            <div class="doc-frame-header"><span class="doc-frame-label">WORKSHOP Q&amp;A</span></div>
            <h3>輸入工作坊密碼，閱讀問答。</h3>
            <form id="qa-unlock-form">
              <div class="password-row"><input id="qa-password" aria-label="工作坊密碼" name="password" type="password" autocomplete="current-password" required aria-describedby="qa-gate-status" /><button type="submit" disabled>解鎖問答</button></div>
            </form>
            <p id="qa-gate-status" role="status" aria-live="polite"></p>
            <noscript><p>請啟用 JavaScript，以在本機解密問答。</p></noscript>
          </div>
          <div class="qa-unlocked-bar" hidden><span>問答已解鎖</span><button type="button" id="qa-lock">鎖定</button></div>
          <div id="qa-content" hidden></div>
          <script id="qa-payload" type="application/json" set:html={JSON.stringify(encryptedQa)} />
        </section>

        </main>
        <footer class="book-footer">
          <p>Bo An · AI 與藝術史工作坊 · 2026</p>
          <div><a href="#preparation">課前準備 ↑</a><a href={issues}>到 Issues 提問 ↗</a><a href={workspace}>Workspace ↗</a><a href={`${workspace}/blob/main/session-01/instructions.md`}>第一場說明 ↗</a></div>
        </footer>
      </div>
    </div>
    <script>
      import '../scripts/book';
    </script>
  </body>
</html>
