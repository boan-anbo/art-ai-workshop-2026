---
import type { MarkdownInstance } from 'astro';
import Workshops from '../content/workshops.md';
import { topics, type TopicId } from '../data/topics';
import '../styles/site.css';

const workspace = 'https://github.com/boan-anbo/art-ai-workshop-2026';
const issues = `${workspace}/issues/new?template=question.yml`;
interface QuestionMetadata {
  id: string;
  title: string;
  participant: string;
  programme: string;
  topics: TopicId[];
}
const questions = Object.values(import.meta.glob<MarkdownInstance<QuestionMetadata>>(
  '../content/qa/*.md', { eager: true },
)).sort((a, b) => a.frontmatter.id.localeCompare(b.frontmatter.id, 'en', { numeric: true }));
const questionIds = questions.map(({ frontmatter }) => frontmatter.id);
if (new Set(questionIds).size !== questionIds.length) {
  throw new Error('Each question response must have a distinct id.');
}
for (const { frontmatter } of questions) {
  if (!/^\d{2}\.\d$/.test(frontmatter.id) || !frontmatter.title || !frontmatter.participant
    || !frontmatter.programme || !frontmatter.topics?.length
    || frontmatter.topics.some((id) => !topics.some((topic) => topic.id === id))) {
    throw new Error(`Invalid question metadata: ${frontmatter.id}`);
  }
}
const anchor = (id: string) => `q-${id.replace('.', '-')}`;
// The page note already names these three as drawn mainly from Bo's dictation.
const dictated = new Set(['01.1', '01.3', '02.1']);
const groups: { key: string; participant: string; programme: string; items: typeof questions }[] = [];
for (const question of questions) {
  const key = question.frontmatter.id.slice(0, 2);
  const last = groups.at(-1);
  if (last?.key === key) last.items.push(question);
  else groups.push({ key, participant: question.frontmatter.participant, programme: question.frontmatter.programme, items: [question] });
}
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="從同學的研究問題出發，討論 AI 與數位工具如何參與藝術研究。CUHK 藝術研究工作坊的課前問答與內容索引。" />
    <meta name="theme-color" content="#f8f4ec" />
    <title>AI 與藝術研究 — 課前問答</title>
    <link rel="canonical" href={new URL(import.meta.env.BASE_URL, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#questions">跳至問答</a>
    <div class="page-shell">
      <header class="masthead">
        <a class="wordmark" href={import.meta.env.BASE_URL}>藝術研究<span class="wordmark-divider">／</span>AI</a>
        <nav aria-label="主要導覽">
          <a href="#questions">問答</a>
          <a href="#workshops">兩場內容</a>
          <a href={workspace}>Workspace <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main>
        <section class="intro" aria-labelledby="page-title">
          <div class="intro-main">
            <p class="eyebrow" lang="en">ART RESEARCH · A WORKING CONVERSATION</p>
            <h1 id="page-title">從你的問題<br />開始。</h1>
            <p class="lead">AI 與數位工具可以怎樣參與藝術研究？<br class="desktop-break" />我們從同學的材料、創作與疑問出發。</p>
            <p class="translation-note">29 個問題逐題回應。01.1、01.3 及 02.1 主要整理自 Bo 的口述；其餘由助手依 Bo 授權、參照其教學與研究方法逐題整理為課前討論稿。具體材料的效果仍需實測，原問題可展開閱讀。</p>
            <a class="text-link" href="#questions">按順序閱讀問答 <span aria-hidden="true">↓</span></a>
          </div>
          <aside class="session-note" aria-label="工作坊資料">
            <p class="eyebrow">工作坊 · 2026</p>
            <p class="institution" lang="en">CUHK<br />Department of Fine Arts</p>
            <dl>
              <div><dt>第一場</dt><dd><time datetime="2026-11-06">11 月 6 日</time>，星期五</dd></div>
              <div><dt>第二場</dt><dd><time datetime="2026-11-13">11 月 13 日</time>，星期五</dd></div>
              <div><dt>時間</dt><dd>14:30–16:30 <span class="time-zone">香港時間</span></dd></div>
            </dl>
            <p class="session-footnote">從同學的問題形成共同練習與各題延伸。<a href="#workshops">看兩場安排</a>。</p>
          </aside>
        </section>

        <section class="questions-section" id="questions" aria-labelledby="questions-title">
          <div class="section-heading question-index">
            <p class="eyebrow">課前 Q&A · {questions.length} 個問題 · {groups.length} 位同學</p>
            <h2 id="questions-title">逐題一覽，點開看答覆。</h2>
            <p>按原問卷順序排列。每題展開後先見英文原問題，再見中文答覆與相關內容。</p>
            <div class="qa-tools" hidden>
              <button type="button" data-qa="open">全部展開</button>
              <button type="button" data-qa="close">全部收起</button>
            </div>
          </div>
          <div class="qa-groups">
            {groups.map((group) => (
              <section class="qa-group" aria-labelledby={`p-${group.key}`}>
                <h3 class="qa-person" id={`p-${group.key}`}><span class="qa-person-no">{group.key}</span> {group.participant}<small>{group.programme}</small></h3>
                {group.items.map(({ frontmatter: q, Content }) => (
                  <details class="qa" id={anchor(q.id)}>
                    <summary>
                      <span class="qa-no">{q.id}</span>
                      <span class="qa-title">{q.title}</span>
                      {dictated.has(q.id) && <span class="qa-badge" title="主要整理自 Bo 的口述">口述</span>}
                      <span class="qa-chevron" aria-hidden="true"></span>
                    </summary>
                    <div class="qa-body">
                      <div class="prose"><Content /></div>
                      <p class="related-topics">相關內容：{q.topics.map((id, i) => (
                        <><span>{i > 0 ? ' ／ ' : ''}</span><a href={`#topic-${id}`}>{topics.find((t) => t.id === id)?.title}</a></>
                      ))}</p>
                    </div>
                  </details>
                ))}
              </section>
            ))}
          </div>
        </section>

        <section class="topics-section" id="workshops" aria-labelledby="workshops-title">
          <div class="section-heading">
            <p class="eyebrow">兩場 · 每場 120 分鐘</p>
            <h2 id="workshops-title">把共同方法做通。</h2>
          </div>
          <div class="prose workshop-prose"><Workshops /></div>
        </section>

        <section class="topics-section" id="topics" aria-labelledby="topics-title">
          <div class="section-heading">
            <p class="eyebrow">WORKSHOP 內容</p>
            <h2 id="topics-title">問題會帶我們到哪裡？</h2>
            <p>共同技術集中練習，各題的材料、限制與論證保留在自己的答覆中。</p>
          </div>
          <div class="topic-list">
            {topics.map((topic) => (
              <article class="topic" id={`topic-${topic.id}`}>
                <span class="topic-number" aria-hidden="true">{topic.number}</span>
                <div><h3>{topic.title}</h3><p>{topic.description}</p>
                  <p class="topic-questions">相關問題：{questions.filter(({ frontmatter }) => frontmatter.topics.includes(topic.id)).map(({ frontmatter: q }, i) => (
                    <><span>{i > 0 ? '、' : ''}</span><a href={`#${anchor(q.id)}`}>{q.id}</a></>
                  ))}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="ask-section" aria-labelledby="ask-title">
          <div>
            <p class="eyebrow">繼續對話</p>
            <h2 id="ask-title">還有其他問題？</h2>
            <p>直接到 workspace 的 GitHub Issues 提問。可以談你的材料、想完成的工作，或嘗試過但仍不清楚的地方。</p>
          </div>
          <a class="ask-link" href={issues}>到 Issues 提問 <span aria-hidden="true">↗</span></a>
        </section>
      </main>

      <footer>
        <p>Bo An · AI 與藝術研究 · 2026</p>
        <div><a href={workspace}>Workspace ↗</a><a href={`${workspace}/tree/main/session-01`}>課前準備 ↗</a></div>
      </footer>
    </div>
    <script>
      // Progressive enhancement: the questions work as plain <details> without this.
      const items = [...document.querySelectorAll<HTMLDetailsElement>('details.qa')];
      const showOriginal = (item: HTMLDetailsElement) => item
        .querySelectorAll<HTMLDetailsElement>('details.original-question')
        .forEach((d) => { d.open = true; });
      items.forEach((item) => item.addEventListener('toggle', () => { if (item.open) showOriginal(item); }));
      const tools = document.querySelector<HTMLElement>('.qa-tools');
      tools?.removeAttribute('hidden');
      tools?.addEventListener('click', (event) => {
        const action = (event.target as HTMLElement | null)?.closest('button')?.dataset.qa;
        if (action) items.forEach((item) => { item.open = action === 'open'; });
      });
      const openFromHash = () => {
        const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
        if (target instanceof HTMLDetailsElement && target.matches('details.qa')) { target.open = true; target.scrollIntoView(); }
      };
      addEventListener('hashchange', openFromHash);
      openFromHash();
      addEventListener('beforeprint', () => items.forEach((item) => { item.open = true; }));
    </script>
  </body>
</html>
